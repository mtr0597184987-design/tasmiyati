{
  "name": "tasmiyati",
  "version": "1.0.0",
  "private": true,
  "description": "تسمياتي | بيئة الكتابة الذكية — تطبيق ويب تعليمي لتدريس مهارات الكتابة العربية",
  "type": "module",
  "engines": { "node": ">=22.13 <25" },
  "scripts": {
    "dev": "node scripts/build.mjs --watch & tsx watch server/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "start:dev": "tsx server/index.ts",
    "validate": "tsx scripts/validate-content.ts",
    "lessons": "node scripts/build-lessons.mjs",
    "check-guide": "node scripts/check-guide.mjs",
    "check-book": "node scripts/check-book.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/api.test.mjs tests/replica.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
