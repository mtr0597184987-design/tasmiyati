      "materials": [
        {
          "type": "modelCard",
          "title": "النص قبل المراجعة",
          "tone": "weak",
          "rows": [
            {
              "label": "النص",
              "value": "تنظيم الوقت مهم. الطالبه التي تنظم وقتها تنجز واجباتها بسرعه، وتنجز واجباتها بسرعة ولا تتأخر. وأيضًا تنظيم الوقت يجعل الأمور تمشي بشكل كويس وكذا. لأن الطالبات الذي ينظمن وقتهن يشعرون بالراحه ، وفي النهاية الرياضة مفيدة للجسم"
            }
          ],
          "proposed": true
        },
        {
          "type": "thinkAloud",
          "title": "تفكير بصوت مسموع",
          "intro": "سأراجع النص خطوة خطوة، وأشرح سبب كل تعديل.",
          "steps": [
            {
              "title": "صياغة خاتمة مناسبة",
              "text": "الجملة الأخيرة عن الرياضة تخرج عن الموضوع. أحذفها، وأكتب خاتمة تتصل بتنظيم الوقت: «لذا، فإن البدء بجدول يومي بسيط خطوة أولى نحو حياة دراسية أكثر توازنًا»."
            },
            {
              "title": "الأخطاء الإملائية والنحوية",
              "text": "«الطالبه» و«بسرعه» و«الراحه» تُكتب بالتاء المربوطة: الطالبة، بسرعة، الراحة. و«الطالبات الذي... يشعرون» صوابها: «الطالبات اللاتي... يشعرن»؛ لأن الاسم الموصول والفعل يطابقان جمع المؤنث."
            },
            {
              "title": "حذف التكرار",
              "text": "جملة «وتنجز واجباتها بسرعة» تكررت دون إضافة، فأحذف المكرر وأضيف معنى جديدًا: التوفيق بين المذاكرة والراحة."
            },
            {
              "title": "إعادة صياغة العبارة الغامضة",
              "text": "«يجعل الأمور تمشي بشكل كويس وكذا» عبارة عامية غامضة، فأستبدل بها معنى دقيقًا بالفصحى."
            },
            {
              "title": "مراجعة الترقيم",
              "text": "أحذف المسافة قبل الفاصلة، وأضع نقطة في نهاية النص، وفاصلة بعد «لذا»."
            }
          ],
          "proposed": true
        },
        {
          "type": "modelCard",
          "title": "النص بعد المراجعة",
          "tone": "strong",
          "rows": [
            {
              "label": "النص",
              "value": "يُعد تنظيم الوقت عادة مهمة في حياة الطالبة. فالطالبة التي تنظم وقتها تنجز واجباتها بسرعة دون تأخير، ويساعدها التنظيم على التوفيق بين المذاكرة والراحة. والطالبات اللاتي ينظمن أوقاتهن يشعرن بالراحة والطمأنينة. لذا، فإن البدء بجدول يومي بسيط خطوة أولى نحو حياة دراسية أكثر توازنًا."
            }
